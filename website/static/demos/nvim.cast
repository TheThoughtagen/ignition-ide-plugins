[77.517, "o", "\u001b[?25l\r\n\u001b(B\u001b[0;1m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24msystem.tag.\u001b(B\u001b[0;1m\u001b[38:2:238:241:248m\u001b[48:2:107:83:0mreadBlocking\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m                                                                     \r\n                                                                                            \r\n\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24msystem.tag.\u001b(B\u001b[m\u001b[38:2:238:241:248m\u001b[48:2:107:83:0mreadBlocking\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24m(tagPaths, timeout=45000)\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m                                            \r\n\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24m  -> List[QualifiedValue]\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m                                                                   \r\n                                                                                            \r\nReads the value of tags at the given paths. Blocks until complete or timeout.               \r\n                                                                             "]
[77.517, "o", "               \r\n\u001b(B\u001b[0;1m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mParameters:\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m                                                                                 \r\n\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24m- tagPaths\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m: String | List\u001b(B\u001b[0;4m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mString\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m                                                             \r\n\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24m  \u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mSingle tag path or list of tag paths to read                                              \r\n\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24m- timeout\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m: int (optional) = 45000                                                           \r\n\u001b(B\u001b[m\u001b[38:2:140:248:247m\u001b[48:2:28:36:24m  \u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mTimeout in milliseconds                                                                   \r\n                                       "]
[77.517, "o", "                                                     \r\n\u001b(B\u001b[0;1m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mReturns:\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m                                                                                    \r\nList\u001b(B\u001b[0;4m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mQualifiedValue\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m - List of QualifiedValue objects with .value, .quality, and .timestamp   \r\n                                                                                            \r\n\u001b(B\u001b[0;1m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24mScope:\u001b(B\u001b[m\u001b[38:2:238:232:214m\u001b[48:2:28:36:24m Gateway, Vision, Perspective                                                         \u001b[8;31H\u001b[?25h"]
